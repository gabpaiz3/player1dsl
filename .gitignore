# Dependencies and package-manager state
node_modules/
.pnp.*

# TypeScript/build output
dist/
build/
out/
coverage/
*.tsbuildinfo

# Generated Player1DSL artifacts
*.bin
*.a26
*.sym
*.lst
*.map
*.trace
*.frame.png
*.frame.json
*.tia-trace.json

# ...but goldens are checked in deliberately, and an ignored golden is silently
# swallowed rather than committed -- the worst failure mode a golden has (spec
# review 2.4). ROM bytes are stored as hashes; the human-readable artifacts are
# stored whole, because those are the ones that diff usefully.
!tests/goldens/**/*.trace
!tests/goldens/**/*.lst
!tests/goldens/**/*.frame.json
!tests/goldens/**/*.tia-trace.json

# Reference screenshots of commercial titles, kept locally for design reference.
# AGENTS.md forbids committing third-party ROMs or commercial assets, and
# screenshots are exactly that. What the collection is FOR is captured instead in
# docs/genre-survey.md, which cites the titles and their source without
# redistributing anything.
game-images/

# Local tooling and emulator configuration
.p1/
.stella/
stella.pro
P1_EMULATOR

# Environment and local settings
.env
.env.*
!.env.example
*.local

# Logs and diagnostic dumps
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors and operating systems
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

# Screen captures used to verify ROM output. Both spellings: the directory on
# disk is "screeencaps".
screencaps/
screeencaps/

# Terminal Paste Image folder
.cp-images/

# TypeScript build info and emitted declarations
*.tsbuildinfo
packages/*/dist/
